# Copy this into Streamlit Cloud -> App -> Settings -> Secrets  (NEVER commit the real values to GitHub)

[sheets]
# spreadsheet URL or just the ID between /d/ and /edit
order_punching    = "https://docs.google.com/spreadsheets/d/XXXX/edit"   # file "Order_Punching_Sheet": tabs Client_Master + Order_List
finished_goods    = "https://docs.google.com/spreadsheets/d/XXXX/edit"   # file "Finished_Goods_Master": tab Finished_Goods
order_to_dispatch = "https://docs.google.com/spreadsheets/d/XXXX/edit"   # file "002_Order_to_Dispatch": tab FR1
sales_invoice     = "https://docs.google.com/spreadsheets/d/XXXX/edit"   # file "Sales_Invoice_Data_Appsheet": tab Sales_Data

[tabs]   # optional - only if your tab names differ
# client_master  = "Client_Master"
# order_list     = "Order_List"
# finished_goods = "Finished_Goods"
# fr1            = "FR1"
# sales_data     = "Sales_Data"

[gcp_service_account]
# paste the fields of your service-account JSON key here
type = "service_account"
project_id = "..."
private_key_id = "..."
private_key = "-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
client_email = "dashboard@your-project.iam.gserviceaccount.com"
client_id = "..."
token_uri = "https://oauth2.googleapis.com/token"
